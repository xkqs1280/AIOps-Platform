# Copy to backend/.env and replace all example values before deployment.
# 默认连接：postgres / postgres（一键部署时 PG 密码须设置为 postgres）
DATABASE_URL=postgresql+psycopg_async://postgres:postgres@localhost:5432/aiops
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-a-long-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
# Leave blank unless every managed device has its own credentials.
DEFAULT_DEVICE_USERNAME=
DEFAULT_DEVICE_PASSWORD=
# ---- SSH 主机密钥校验（平台 → 设备管理通道 MITM 防护）----
# SSH_STRICT_HOST_KEY_CHECKING=true（默认）时，asyncssh 只信任 SSH_KNOWN_HOSTS
# 中的主机密钥；必须先把纳管设备的公钥写入该 known_hosts 文件（OpenSSH 格式，
# 每行: "<host>[:port] <keytype> <base64>"）。可在能连通设备的管理机上用
# `ssh-keyscan -p <port> <ip> >> backend/ssh_known_hosts` 批量生成，然后填路径。
# 留空且校验开启时，SSH 类操作会明确报错提示（不静默降级），不会出现
# "自动接受任何密钥"的中间人窗口；Telnet 走 telnetlib3，不受本开关影响。
SSH_KNOWN_HOSTS=
SSH_STRICT_HOST_KEY_CHECKING=true
AUTH_ENABLED=true
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Used only when the users table is empty. Remove these values after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
ALLOW_INSECURE_BOOTSTRAP=false
# Set true only behind HTTPS. 默认 HTTP 部署必须为 false，否则登录 cookie 无法生效。
COOKIE_SECURE=false
INGEST_API_KEY=replace-with-a-long-random-ingest-key
# Do not use * here. Add the exact browser origins used by your deployment.
CORS_ORIGINS=https://localhost:8000,https://127.0.0.1:8000
API_PREFIX=/api/v1
MAX_DEVICES=300

# ---- 设备日志中心（内置 syslog UDP 接收器）----
# 接收器在后端进程内监听 UDP，开箱即用；Linux 下绑 <1024 端口需要
# CAP_NET_BIND_SERVICE（install.sh 生成的 systemd unit 已带 AmbientCapabilities）。
SYSLOG_UDP_ENABLED=true
SYSLOG_UDP_HOST=0.0.0.0
SYSLOG_UDP_PORT=514
# 平台侧地址：设备通过它回传日志。留空时由页面在候选网卡地址里选。
# 多网卡主机（如同时有业务网段/管理网段）建议显式指定，避免设备连错网段。
SYSLOG_ADVERTISE_ADDRESS=
# 设备时钟相对 UTC 的偏移小时数。H3C 出厂 display clock 返回 UTC；
# 若设备已按北京时间设置时钟，这里填 8，否则 device_time 会比实际早 8 小时。
# 原始时间串在 device_time_raw 中始终保留，可事后核对。
SYSLOG_DEVICE_TZ_OFFSET_HOURS=8
# 接收端保护：队列上限 / 攒批条数 / 攒批间隔秒数 / 按来源 IP 的限流窗口与上限
SYSLOG_QUEUE_MAX=50000
SYSLOG_BATCH_SIZE=500
SYSLOG_FLUSH_INTERVAL=2.0
SYSLOG_RATE_WINDOW_SECONDS=10
SYSLOG_RATE_MAX_PER_WINDOW=2000
SYSLOG_MAX_MESSAGE_BYTES=8192
# 设备日志留存天数：等保 2.0 三级要求网络日志留存 ≥ 6 个月，不要调小
DEVICE_LOGS_DAYS=180
# 演示/样例数据接口：默认关闭。造假数据混进审计数据在等保场景是硬伤。
DEMO_DATA_ENABLED=false
