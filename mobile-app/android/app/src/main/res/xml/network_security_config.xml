<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 信任系统证书 + 用户安装的证书：
         允许 APP 接入各客户自部署平台的自签名 HTTPS（用户在手机安装服务器证书后即可） -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
